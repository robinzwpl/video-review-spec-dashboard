# ============================================================
# 排除体积大的、或可重新生成的产物，避免进入 git 历史
# ============================================================

# 源视频（113MB）与下载器原始素材目录
科技绝对值/

# 全部中间产物：226 张关键帧、日志、音频、模型、核对拼图
output/

# 视频与音频文件
*.mp4
*.mkv
*.mov
*.avi
*.wav
*.flv

# 模型权重目录（faster-whisper 等，数百 MB）
**/models/

# 日志
*.log

# WorkBuddy 项目数据（其中的知识已提炼进 skill 的 references/）
.workbuddy/

# ============================================================
# Python 常规排除
# ============================================================
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/

# 交付用 zip 包
*.zip
